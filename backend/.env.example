PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_contrasena
PGDATABASE=tiendita_joyas

# Seguridad (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generar_clave_secreta

# Postalia (códigos postales de México) - https://postalia.com.mx
POSTALIA_TOKEN=tu_token_de_postalia

# Google Drive (OAuth 2.0) - imágenes de productos
# Crear credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_DRIVE_REDIRECT_PORT=5876
# Nombre de la carpeta que la app crea (una vez) en tu Drive para guardar imágenes
GOOGLE_DRIVE_FOLDER_NOMBRE=Tiendita las joyas - imagenes
